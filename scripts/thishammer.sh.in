# Source this script to set up the HAMMER build that this script is part of.
#
# Conveniently an alias like this can be defined in .bashrc or .zshrc:
#   alias thishammer=". bin/thishammer.sh"
#
# This script is for the bash like shells, see thishammer.csh for csh like shells.
#
# Author: Fons Rademakers, 18/8/2006

# shellcheck disable=SC2123,SC3043
# Whole-file directives
# Disable SC2123 to not warn PATH modification
# Disable SC3043 to not warn for the local keyword

drop_from_path()
{
   # Assert that we got enough arguments
   if test $# -ne 2 ; then
      echo "drop_from_path: needs 2 arguments" >&2
      return 1
   fi

   local p="$1" 2>/dev/null
   local drop="$2" 2>/dev/null

   newpath="$(echo "$p" | sed -e "s;:${drop}:;:;g" \
                          -e "s;:${drop}\$;;g"   \
                          -e "s;^${drop}:;;g"   \
                          -e "s;^${drop}\$;;g")"
}

clean_environment()
{

   if [ -n "${old_hammersys-}" ] ; then
      if [ -n "${PATH-}" ]; then
         drop_from_path "$PATH" "${old_hammersys}/bin"
         PATH=$newpath
      fi
      if [ -n "${LD_LIBRARY_PATH-}" ]; then
         drop_from_path "$LD_LIBRARY_PATH" "${old_hammersys}/lib"
         drop_from_path "$LD_LIBRARY_PATH" "${old_hammersys}/lib/Hammer"
         LD_LIBRARY_PATH=$newpath
      fi
      if [ -n "${DYLD_LIBRARY_PATH-}" ]; then
         drop_from_path "$DYLD_LIBRARY_PATH" "${old_hammersys}/lib"
         drop_from_path "$DYLD_LIBRARY_PATH" "${old_hammersys}/lib/Hammer"
         DYLD_LIBRARY_PATH=$newpath
      fi
      if [ -n "${SHLIB_PATH-}" ]; then
         drop_from_path "$SHLIB_PATH" "${old_hammersys}/lib"
         drop_from_path "$SHLIB_PATH" "${old_hammersys}/lib/Hammer"
         SHLIB_PATH=$newpath
      fi
      if [ -n "${LIBPATH-}" ]; then
         drop_from_path "$LIBPATH" "${old_hammersys}/lib"
         drop_from_path "$LIBPATH" "${old_hammersys}/lib/Hammer"
         LIBPATH=$newpath
      fi
      if [ -n "${PYTHONPATH-}" ]; then
         drop_from_path "$PYTHONPATH" "${old_hammersys}/lib"
         drop_from_path "$PYTHONPATH" "${old_hammersys}/lib/python@Python3_VERSION_MAJOR@.@Python3_VERSION_MINOR@/site-packages"
         PYTHONPATH=$newpath
      fi
      if [ -n "${ROOT_INCLUDE_PATH-}" ]; then
         drop_from_path "$ROOT_INCLUDE_PATH" "${old_hammersys}/include"
         ROOT_INCLUDE_PATH=$newpath
      fi
      if [ -n "${CMAKE_PREFIX_PATH-}" ]; then
         drop_from_path "$CMAKE_PREFIX_PATH" "${old_hammersys}"
         CMAKE_PREFIX_PATH=$newpath
      fi
   fi
   if [ -z "${MANPATH-}" ]; then
      # Grab the default man path before setting the path to avoid duplicates
      if command -v manpath >/dev/null; then
         default_manpath="$(manpath)"
      elif command -v man >/dev/null; then
         default_manpath="$(man -w 2> /dev/null)"
      else
         default_manpath=""
      fi
   fi
}

set_environment()
{
   if [ -z "${PATH-}" ]; then
      PATH=@CMAKE_INSTALL_PREFIX@/bin; export PATH
   else
      PATH=@CMAKE_INSTALL_PREFIX@/bin:$PATH; export PATH
   fi

   if [ -z "${LD_LIBRARY_PATH-}" ]; then
      LD_LIBRARY_PATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer
      export LD_LIBRARY_PATH       # Linux, ELF HP-UX
   else
      LD_LIBRARY_PATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer:$LD_LIBRARY_PATH
      export LD_LIBRARY_PATH
   fi

   if [ -z "${DYLD_LIBRARY_PATH-}" ]; then
      DYLD_LIBRARY_PATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer
      export DYLD_LIBRARY_PATH       # Linux, ELF HP-UX
   else
      DYLD_LIBRARY_PATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer:$DYLD_LIBRARY_PATH
      export DYLD_LIBRARY_PATH
   fi

   if [ -z "${SHLIB_PATH-}" ]; then
      SHLIB_PATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer
      export SHLIB_PATH       # Linux, ELF HP-UX
   else
      SHLIB_PATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer:$SHLIB_PATH
      export SHLIB_PATH
   fi

   if [ -z "${LIBPATH-}" ]; then
      LIBPATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer
      export LIBPATH       # Linux, ELF HP-UX
   else
      LIBPATH=@HAMMER_EXTRA_LIBPATH@@CMAKE_INSTALL_PREFIX@/lib/Hammer:$LIBPATH
      export LIBPATH
   fi

   if [ -z "${PYTHONPATH-}" ]; then
      PYTHONPATH=@CMAKE_INSTALL_PREFIX@/lib/python@Python3_VERSION_MAJOR@.@Python3_VERSION_MINOR@/site-packages
      export PYTHONPATH       # Linux, ELF HP-UX
   else
      PYTHONPATH=@CMAKE_INSTALL_PREFIX@/lib/python@Python3_VERSION_MAJOR@.@Python3_VERSION_MINOR@/site-packages:$PYTHONPATH
      export PYTHONPATH
   fi

   if [ -n "@PYHEPMC3_SITE_PACKAGES@" ]; then
      if [ -z "${PYTHONPATH-}" ]; then
         PYTHONPATH=@PYHEPMC3_SITE_PACKAGES@
         export PYTHONPATH
      else
         PYTHONPATH=@PYHEPMC3_SITE_PACKAGES@:$PYTHONPATH
         export PYTHONPATH
      fi
   fi

   if [ -z "${ROOT_INCLUDE_PATH-}" ]; then
      ROOT_INCLUDE_PATH=@CMAKE_INSTALL_PREFIX@/include
      export ROOT_INCLUDE_PATH
   else
      ROOT_INCLUDE_PATH=@CMAKE_INSTALL_PREFIX@/include:$ROOT_INCLUDE_PATH
      export ROOT_INCLUDE_PATH
   fi

   if [ -z "${CMAKE_PREFIX_PATH-}" ]; then
      CMAKE_PREFIX_PATH=$HAMMERSYS; export CMAKE_PREFIX_PATH       # Linux, ELF HP-UX
   else
      CMAKE_PREFIX_PATH=$HAMMERSYS:$CMAKE_PREFIX_PATH; export CMAKE_PREFIX_PATH
   fi

}

getTrueShellExeName() { # mklement0 https://stackoverflow.com/a/23011530/7471760
    # shellcheck disable=SC3043 # assume that local is available
   local trueExe nextTarget 2>/dev/null # ignore error in shells without `local`
   # Determine the shell executable filename.
   if [ -r "/proc/$$/cmdline" ]; then
      trueExe=$(cut -d '' -f1 /proc/$$/cmdline 2>/dev/null) || trueExe=$(xargs -0 -n 1 < /proc/$$/cmdline | head -n 1) || return 1
      # Qemu emulation has cmdline start with the emulator
      if [ "${trueExe##*qemu*}" != "${trueExe}" ]; then
         # but qemu sets comm to the emulated command
         trueExe=$(cat /proc/$$/comm) || return 1
      fi
   else
      trueExe=$(ps -p $$ -o comm=) || return 1
   fi
   # Strip a leading "-", as added e.g. by macOS for login shells.
   if [ "${trueExe#-}" != "$trueExe" ]; then
      trueExe=${trueExe#-}
   fi
   # Determine full executable path.
   if [ "${trueExe#/}" = "$trueExe" ]; then
      trueExe=$(if [ -n "${ZSH_VERSION-}" ]; then builtin which -p "$trueExe"; else which "$trueExe"; fi)
   fi
   # If the executable is a symlink, resolve it to its *ultimate*
   # target.
   while nextTarget=$(readlink "$trueExe"); do trueExe=$nextTarget; done
   # Output the executable name only.
   printf '%s' "$(basename "$trueExe")"
}

### main ###


if [ -n "${HAMMERSYS-}" ] ; then
   old_hammersys=${HAMMERSYS}
fi


SHELLNAME=$(getTrueShellExeName)
if [ "$SHELLNAME" = "bash" ]; then
   # shellcheck disable=SC3028,SC3054 # Bash-only syntax
   SOURCE=${BASH_ARGV[0]}
elif [ -z "${SHELLNAME}" ]; then # in case getTrueShellExeName does not work, fall back to default
   echo "WARNING: shell name was not found. Assuming 'bash'."
   # shellcheck disable=SC3028,SC3054 # Bash-only syntax
   SOURCE=${BASH_ARGV[0]}
elif [ "$SHELLNAME" = "zsh" ]; then
   # shellcheck disable=all
   SOURCE=${(%):-%N}
else # dash or ksh
   x=$(lsof -p $$ -Fn0 2>/dev/null | tail -1); # Paul Brannan https://stackoverflow.com/a/42815001/7471760
   SOURCE=${x#*n}
fi


if [ -z "${SOURCE}" ]; then
   if [ -f bin/thishammer.sh ]; then
      HAMMERSYS="$PWD"; export HAMMERSYS
   elif [ -f ./thishammer.sh ]; then
      HAMMERSYS=$(cd .. > /dev/null && pwd); export HAMMERSYS
      if [ -z "$HAMMERSYS" ]; then
         echo "ERROR: \"cd ..\" or \"pwd\" failed" >&2
         return 1
      fi
   else
      if [ "$SHELLNAME" = "bash" ] ; then
         echo "ERROR: please turn on extdebug using \"shopt -s extdebug\"" >&2
         echo "or \"cd where/Hammer/is\" before calling \". bin/thishammer.sh\"" >&2
      else
         echo "ERROR: must \"cd where/Hammer/is\" before calling \". bin/thishammer.sh\" for this version of \"$SHELLNAME\"!" >&2
      fi
      HAMMERSYS=; export HAMMERSYS
      return 1
   fi
else
   # get param to "."
   thishammer="$(dirname "${SOURCE}")"
   HAMMERSYS=$(cd "${thishammer}/.." > /dev/null && pwd); export HAMMERSYS
   if [ -z "$HAMMERSYS" ]; then
      echo "ERROR: \"cd ${thishammer}/..\" or \"pwd\" failed" >&2
      return 1
   fi
fi


clean_environment
set_environment



if (root-config --arch | grep -v win32gcc | grep -q -i win32); then
   HAMMERSYS="$(cygpath -w "$HAMMERSYS")"
fi

unset old_hammersys
unset thishammer
unset -f drop_from_path
unset -f clean_environment
unset -f set_environment
