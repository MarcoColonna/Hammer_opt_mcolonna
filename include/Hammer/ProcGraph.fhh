// -*- C++ -*-
#ifndef HAMMER_PROCESSGRAPH_FHH
#define HAMMER_PROCESSGRAPH_FHH


#include <cstdint>

#include "Hammer/IndexTypes.hh"

namespace Hammer {

    class AmplitudeBase;

    enum class AmplType : uint8_t { VERTEX = 0, PARENTEDGE, DAUGHTEREDGE, FULLEDGE };

    struct AmplEntry {
        AmplitudeBase* ptr;
        AmplType type;
    };

    struct SelectedAmplEntry {
        NumDenPair<AmplEntry> amplitudes;
        ParticleIndex daughterIdx;
    };

    class ProcGraph;

} // namespace Hammer

#endif
