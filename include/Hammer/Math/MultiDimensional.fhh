// -*- C++ -*-
#ifndef HAMMER_MATH_MULTIDIMENSIONAL_FHH
#define HAMMER_MATH_MULTIDIMENSIONAL_FHH

#include <cstdint>
#include <set>
#include <utility>
#include <memory>

#include <functional>
#include <type_traits>

#include <boost/container/small_vector.hpp>


namespace Hammer {

    constexpr static std::size_t min_small_vector_size = 8;
    constexpr static std::size_t cache_line_size = 64;

    template <class T, class ALLOC = std::allocator<T>>
    using multidim_vector = boost::container::small_vector<T, (((min_small_vector_size * sizeof(T) + 3 * sizeof(void*) + cache_line_size - 1) / cache_line_size) * cache_line_size -3 * sizeof(void*)) / sizeof(T), ALLOC>;

    using IndexType = uint16_t; // Lots of space for integrator dimensions
    using IndexPair = std::pair<IndexType, IndexType>;
    using IndexList = multidim_vector<IndexType>;
    using UniqueIndexList = std::set<IndexType>;
    using IndexPairList = multidim_vector<IndexPair>;
    // using IndexBoolPairList = multidim_vector<std::pair<IndexType, bool>>;

    using LabelSignature = std::pair<size_t, bool>; // Index and sign of first element

    using PositionType = size_t;
    using PositionPair = std::pair<PositionType, PositionType>;
    using PositionList = multidim_vector<PositionType>;
    using PositionPairList = multidim_vector<PositionPair>;

    using PosIndexPair = std::pair<PositionType, IndexType>;
    using PosIndexPairList = multidim_vector<PosIndexPair>;

    enum IndexLabel : int64_t;
    using LabelPair = std::pair<IndexLabel, IndexLabel>;
    using LabelsList = multidim_vector<IndexLabel>;
    using UniqueLabelsList = std::set<IndexLabel>;
    using LabelPairsSet = std::set<LabelPair>;

    using FlagList = multidim_vector<bool>;


    namespace MultiDimensional {

        class IContainer;
        using TensorData = std::unique_ptr<IContainer>;
        using SharedTensorData = std::shared_ptr<IContainer>;
    } // namespace MultiDimensional

} // namespace Hammer


namespace std {
    // specialize std::hash for Hammer::IndexLabel
    template <>
    class hash<Hammer::IndexLabel> {
        using underlying_type = typename std::underlying_type<Hammer::IndexLabel>::type;
        using result_type = std::size_t;
        using argument_type = Hammer::IndexLabel;
        result_type operator()(argument_type label) const noexcept {
            return std::hash<underlying_type>{}(static_cast<underlying_type>(label));
        }
    };
} // namespace std

#include <boost/container_hash/hash.hpp>
namespace boost {
    template <std::size_t SZ, class ALLOC, class OPTS>

    struct hash<boost::container::small_vector<Hammer::IndexLabel, SZ, ALLOC, OPTS>>
        : public boost::hash_detail::hash_base<boost::container::small_vector<Hammer::IndexLabel, SZ, ALLOC, OPTS>> {
        std::size_t operator()(const boost::container::small_vector<Hammer::IndexLabel, SZ, ALLOC, OPTS>& v) const {
            using underlying_type = typename std::underlying_type<Hammer::IndexLabel>::type;
            const underlying_type* first = reinterpret_cast<const underlying_type*>(v.data());
            return boost::hash_range(first, first + v.size());
        }
    };
} // namespace boost

#endif
